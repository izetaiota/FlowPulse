APP_NAME=心流 FlowPulse API
DATA_DIR=./data
TRANSCRIBE_ENGINE=mock
MAX_DOWNLOAD_BYTES=524288000
REQUEST_TIMEOUT_SECONDS=30

# Optional fallback resolver implementing GET /api/hybrid/video_data?url=...
DOUYIN_RESOLVER_BASE_URL=

# OpenAI-compatible transcription
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Local faster-whisper transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=zh

# Aliyun Tingwu transcription
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PREFIX=douyin-transcribe
TINGWU_APP_KEY=
TINGWU_REGION=cn-beijing
TINGWU_LANGUAGE_HINT=cn
TINGWU_POLL_INTERVAL_SECONDS=5
TINGWU_TIMEOUT_SECONDS=1800

# Xiaohongshu (XHS) —— optional outbound proxy, e.g. http://127.0.0.1:7890
XHS_PROXY=

# ---- Web 登录（单账号）----
# ADMIN_PASSWORD 留空 = 关闭登录（本地直通）；设置后全部 API 需登录（Bearer Token / ?token=）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 浏览器会话层（P0.5 骨架，P3 抖音接入时启用；patchright 安装：pip install -e ".[browser]"）---
# 浏览器登录总开关（当前仅作预留）
BROWSER_ENABLED=false
# 常驻浏览器上下文上限（超量按最久未用回收）
BROWSER_MAX_LIVE_CONTEXTS=4

# --- 小红书作品监控（P1）---
# 监控调度总开关（false = 关闭后台扫描，页面仍可手动触发）
XHS_MONITOR_ENABLED=true
# 调度轮询间隔（秒）
XHS_MONITOR_TICK_SECONDS=60
# 新建监控目标的默认扫描周期（分钟），目标级可覆盖
XHS_MONITOR_DEFAULT_INTERVAL_MINUTES=30

# --- 抖音平台（P3）---
# 抖音作品监控调度总开关
DOUYIN_MONITOR_ENABLED=true
# 抖音监控调度轮询间隔（秒）
DOUYIN_MONITOR_TICK_SECONDS=60
# 拦截式读取是否无头（扫码登录始终有头；读取失败时可改 false 观察页面）
DOUYIN_BROWSER_HEADLESS=true

# --- 写操作风控闸（P4）---
RISK_ENABLED=true
# 单账号小时/日写操作配额（0 = 不限）
RISK_HOURLY_LIMIT=10
RISK_DAILY_LIMIT=50
# 安静时段（本地时钟，如 23:00-07:00 跨午夜；空 = 关闭）
RISK_QUIET_HOURS=23:00-07:00

# --- 快手平台（P5）---
KS_MONITOR_ENABLED=true
KS_MONITOR_TICK_SECONDS=60
KS_BROWSER_HEADLESS=true
