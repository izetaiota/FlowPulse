APP_NAME=MetaCorpus 元语助手 API
DATA_DIR=./data
TRANSCRIBE_ENGINE=mock
MAX_DOWNLOAD_BYTES=524288000
REQUEST_TIMEOUT_SECONDS=30

# Optional fallback resolver implementing GET /api/hybrid/video_data?url=...
DOUYIN_RESOLVER_BASE_URL=

# OpenAI-compatible transcription
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Local faster-whisper transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=zh

# Aliyun Tingwu transcription
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PREFIX=douyin-transcribe
TINGWU_APP_KEY=
TINGWU_REGION=cn-beijing
TINGWU_LANGUAGE_HINT=cn
TINGWU_POLL_INTERVAL_SECONDS=5
TINGWU_TIMEOUT_SECONDS=1800
