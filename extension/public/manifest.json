{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "MetaCorpus 元语助手",
  "description": "一键解析短视频、笔记，提取文案字幕与完整元数据，输出结构化语料供给 AI 分析。",
  "version": "0.1.0",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "alarms",
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.xiaohongshu.com/*",
    "https://xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 MetaCorpus 元语助手"
  }
}
